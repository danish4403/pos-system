# Copy this file to ".env" and fill in your own values, then restart the app.

# Get a key from https://console.anthropic.com  (needed only for the
# "scan a photo" features — manual entry works without it).
ANTHROPIC_API_KEY=

# Optional — change the port the app runs on.
PORT=3000

# Optional — any random long string, used to secure admin login sessions.
SESSION_SECRET=change-this-to-a-random-string

# Optional — local Ollama settings for the backend AI foundation.
# Defaults work with a local Ollama install and the Llama 3.2 model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000
